# Unity generated data: scoped so authored assets with these names remain visible.
/simulator/unity/*/[Ll]ibrary/
/simulator/unity/*/[Tt]emp/
/simulator/unity/*/[Oo]bj/
/simulator/unity/*/[Ll]ogs/
/simulator/unity/*/[Uu]ser[Ss]ettings/
/simulator/unity/*/[Bb]uild/
/simulator/unity/*/[Bb]uilds/
/simulator/unity/*/[Mm]emoryCaptures/
/simulator/unity/*/[Rr]ecordings/
/simulator/unity/*/[Tt]est[Rr]esults/
/simulator/unity/*/ExportedObj/
/simulator/unity/*/*.csproj
/simulator/unity/*/*.sln
/simulator/unity/*/*.slnx
/simulator/unity/*/*.unityproj
/simulator/unity/*/*.pidb
/simulator/unity/*/*.booproj
/simulator/unity/*/*.svd
/simulator/unity/*/sysinfo.txt
# Keep Assets/**/*.meta, scenes, prefabs, ProjectSettings and package locks.

# Generated outputs and local runtime evidence.
/build/
/builds/
/dist/
/artifacts/
/TestResults/
/runtime-data/
/captures/
/coverage/

# Python (future backend).
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
/backend/build/
/backend/dist/
.ipynb_checkpoints/

# Local IDE state; project-wide tool settings can be added deliberately later.
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
*.swp
*.swo
*~

# Local secrets/configuration. Never put real credentials in example files.
.env
.env.*
!.env.example
!.env.*.example
.secrets/
credentials/
tokens/
*.credentials.json
*.token
secrets/
*.local.json
*.local.toml
*.local.yaml
*.local.yml
*.pfx
*.p12
*.key
*.pem
*.keystore
*.jks
*.ulf
*.alf
.upmconfig.toml
.npmrc
.pypirc

